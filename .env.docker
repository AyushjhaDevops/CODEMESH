# Development Environment Variables
# Copy this file to .env.local and update values as needed

# Node Environment
NODE_ENV=development
APP_NAME=CodeMesh
APP_VERSION=0.1.0

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# Web Configuration
WEB_PORT=3000
WEB_HOST=0.0.0.0
VITE_API_URL=http://localhost:3001

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=codemesh
DB_PASSWORD=codemesh_password
DB_NAME=codemesh_dev
DATABASE_URL=postgresql://codemesh:codemesh_password@localhost:5432/codemesh_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:6379

# MinIO Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_BUCKET_NAME=codemesh-dev
MINIO_USE_SSL=false

# Authentication (placeholder for future implementation)
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s

# Turbo Configuration
TURBO_TELEMETRY_DISABLED=1
