// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User Management
// ============================================================================

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  username String @unique
  displayName String?
  avatarUrl String?
  passwordHash String
  isEmailVerified Boolean @default(false)
  isActive Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions Session[]
  workspaceMembers WorkspaceMember[]
  projectMembers ProjectMember[]
  messages Message[]
  notifications Notification[]
  comments Comment[]
  createdRepositories Repository[] @relation("RepositoryCreator")
  repositoryMembers RepositoryMember[]
  executionResults ExecutionResult[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  token String @unique
  expiresAt DateTime
  lastActivityAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// Workspaces & Projects
// ============================================================================

model Workspace {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  description String?
  logoUrl String?
  isPublic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members WorkspaceMember[]
  projects Project[]
  repositories Repository[]

  @@index([slug])
  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String @default("member") // admin, member, viewer
  joinedAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  slug String
  description String?
  isPublic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members ProjectMember[]
  files File[]
  folders Folder[]
  resources Resource[]
  messages Message[]
  tasks Task[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMember {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String @default("member") // admin, editor, viewer
  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ============================================================================
// Files & Folders
// ============================================================================

model Folder {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId String? @db.Uuid
  parent Folder? @relation("FolderParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderParent")
  name String
  path String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@unique([projectId, path])
  @@index([projectId])
  @@index([parentId])
  @@map("folders")
}

model File {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId String? @db.Uuid
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name String
  path String
  mimeType String
  size Int
  content String?
  checksum String?
  isLocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
  @@index([folderId])
  @@map("files")
}

// ============================================================================
// Resources
// ============================================================================

model Resource {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type String // database, cache, storage, etc.
  name String
  config String // JSON stored as text
  metadata String? // JSON stored as text
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([type])
  @@map("resources")
}

// ============================================================================
// Communication
// ============================================================================

model Message {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  isEdited Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

model Comment {
  id String @id @default(uuid()) @db.Uuid
  messageId String @db.Uuid
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  isEdited Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
  @@index([userId])
  @@map("comments")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  title String
  message String
  metadata String? // JSON stored as text
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  readAt DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// Repositories & Versioning
// ============================================================================

model Repository {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorId String @db.Uuid
  creator User @relation("RepositoryCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  name String
  slug String
  description String?
  remoteUrl String?
  isPublic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members RepositoryMember[]
  commits Commit[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([creatorId])
  @@map("repositories")
}

model RepositoryMember {
  id String @id @default(uuid()) @db.Uuid
  repositoryId String @db.Uuid
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String @default("member") // admin, contributor, viewer
  joinedAt DateTime @default(now())

  @@unique([repositoryId, userId])
  @@index([repositoryId])
  @@index([userId])
  @@map("repository_members")
}

model Commit {
  id String @id @default(uuid()) @db.Uuid
  repositoryId String @db.Uuid
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  hash String
  message String
  author String
  authorEmail String
  committedAt DateTime
  createdAt DateTime @default(now())

  @@unique([repositoryId, hash])
  @@index([repositoryId])
  @@index([committedAt])
  @@map("commits")
}

// ============================================================================
// Tasks & Execution
// ============================================================================

model Task {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title String
  description String?
  status String @default("pending") // pending, running, completed, failed
  priority String @default("medium") // low, medium, high
  assignedTo String? // User ID
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model Execution {
  id String @id @default(uuid()) @db.Uuid
  taskId String? @db.Uuid
  status String @default("pending") // pending, running, completed, failed
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())

  results ExecutionResult[]

  @@index([status])
  @@index([createdAt])
  @@map("executions")
}

model ExecutionResult {
  id String @id @default(uuid()) @db.Uuid
  executionId String @db.Uuid
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  output String?
  error String?
  exitCode Int?
  duration Int? // milliseconds
  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([userId])
  @@map("execution_results")
}

// ============================================================================
// Deployments
// ============================================================================

model Deployment {
  id String @id @default(uuid()) @db.Uuid
  status String @default("pending") // pending, running, completed, failed
  version String
  environment String // development, staging, production
  startedAt DateTime?
  completedAt DateTime?
  logs String?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([environment])
  @@index([createdAt])
  @@map("deployments")
}
