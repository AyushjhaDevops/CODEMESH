# Use Node.js Alpine image
FROM node:20-alpine

# Install necessary tools
RUN apk add --no-cache curl tini

# Create app directory and non-root user
WORKDIR /app
RUN addgroup -g 999 appgroup && adduser -D -u 999 -G appgroup appuser

# Copy root files
COPY --chown=appuser:appgroup package.json pnpm-workspace.yaml turbo.json ./
COPY --chown=appuser:appgroup .npmrc* ./

# Install pnpm
RUN npm install -g pnpm@8.15.0

# Copy packages
COPY --chown=appuser:appgroup packages ./packages

# Copy API app
COPY --chown=appuser:appgroup apps/api ./apps/api

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build packages and API
RUN pnpm run build --filter @codemesh/api

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=30s \
  CMD curl -f http://localhost:3001/health || exit 1

# Use tini as init process
ENTRYPOINT ["/sbin/tini", "--"]

# Start API
CMD ["pnpm", "run", "dev", "--filter", "@codemesh/api"]
